<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Technical Scan {{ res.as_of }}{% if res.focus_symbols %} — {{ res.focus_symbols|join(", ") }}{% endif %}</title>
<style>
:root {
  --bg: #f7f7f5; --panel: #ffffff; --ink: #1d1f22; --muted: #65686e; --line: #dedfe2; --chip: #eef0f3;
  --up: #1a8f5a; --down: #c8403a; --accent: #2f5fd0; --warn: #b26b00; --warn-bg: #fff4e0;
  --sup: rgba(26,143,90,.16); --res: rgba(200,64,58,.16); --sig: rgba(47,95,208,.10);
  --sma50: #d38b00; --sma200: #6b4fbb; --rsi: #2f5fd0; --pend: #8a5cf5;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #141518; --panel: #1c1e22; --ink: #e8e9eb; --muted: #9a9ea6; --line: #2e3137; --chip: #262a30;
    --up: #39b67a; --down: #e2665f; --accent: #7aa2ff; --warn: #f0b04a; --warn-bg: #2e2412;
    --sup: rgba(57,182,122,.18); --res: rgba(226,102,95,.18); --sig: rgba(122,162,255,.12);
    --sma50: #f0b04a; --sma200: #a58cf0; --rsi: #7aa2ff; --pend: #b195ff;
  }
}
:root[data-theme="dark"] {
  --bg: #141518; --panel: #1c1e22; --ink: #e8e9eb; --muted: #9a9ea6; --line: #2e3137; --chip: #262a30;
  --up: #39b67a; --down: #e2665f; --accent: #7aa2ff; --warn: #f0b04a; --warn-bg: #2e2412;
  --sup: rgba(57,182,122,.18); --res: rgba(226,102,95,.18); --sig: rgba(122,162,255,.12);
  --sma50: #f0b04a; --sma200: #a58cf0; --rsi: #7aa2ff; --pend: #b195ff;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1180px; margin: 0 auto; padding: 16px; }
h1 { font-size: 22px; margin: 4px 0 2px; }
h2 { font-size: 17px; margin: 28px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
h3 { font-size: 15px; margin: 16px 0 6px; }
h4 { font-size: 13px; margin: 12px 0 4px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
a { color: var(--accent); }
.muted { color: var(--muted); }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin: 10px 0; }
.grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
.stat b { display: block; font-size: 18px; }
.stat span { color: var(--muted); font-size: 12px; }
.banner { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn); border-radius: 8px; padding: 8px 12px; margin: 10px 0; font-weight: 600; }
.tablewrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
.tablewrap table { min-width: 560px; }
td.chips { min-width: 170px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { color: var(--muted); font-weight: 600; white-space: nowrap; }
th.sortable { cursor: pointer; user-select: none; }
th.sortable::after { content: " ↕"; opacity: .4; }
td.num, th.num { white-space: nowrap; text-align: right; font-variant-numeric: tabular-nums; }
.chip { display: inline-block; max-width: 100%; background: var(--chip); border-radius: 999px; padding: 1px 8px; margin: 1px 2px 1px 0; font-size: 12px; overflow-wrap: anywhere; }
.chip.bullish, .chip.non_bearish { box-shadow: inset 3px 0 0 var(--up); }
.chip.bearish, .chip.non_bullish { box-shadow: inset 3px 0 0 var(--down); }
.chip.neutral { box-shadow: inset 3px 0 0 var(--muted); }
.tag { white-space: nowrap; font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 4px; border: 1px solid currentColor; }
.tag.with_flow, .tag.true, .tag.uptrend { color: var(--up); }
.tag.countertrend, .tag.false, .tag.downtrend { color: var(--down); }
.tag.mixed, .tag.range, .tag.ignored, .tag.n\/a { color: var(--muted); }
.tag.PENDING_CLOSE, .tag.pending { color: var(--pend); }
.tag.stretched { color: var(--warn); }
.filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 10px; }
.filters select, .filters input { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 4px 6px; font: inherit; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin: 18px 0; }
.card header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
.card header h3 { margin: 0; font-size: 20px; }
.up { color: var(--up); } .down { color: var(--down); }
.cols { display: grid; gap: 16px; grid-template-columns: 1fr 1fr; }
@media (max-width: 760px) { .cols { grid-template-columns: 1fr; } }
.chart { width: 100%; height: auto; display: block; margin: 8px 0; }
.chart .pane { fill: none; stroke: var(--line); }
.chart .grid { stroke: var(--line); stroke-dasharray: 2 3; }
.chart .axis { fill: var(--muted); font-size: 11px; }
.chart .wick { stroke-width: 1; } .chart .wick.up { stroke: var(--up); } .chart .wick.down { stroke: var(--down); }
.chart .body.up { fill: var(--up); } .chart .body.down { fill: var(--down); }
.chart .prov { opacity: .45; stroke-dasharray: 2 2; }
.chart .zone.support { fill: var(--sup); } .chart .zone.resistance { fill: var(--res); }
.chart .lvl { fill: none; stroke-width: 1; stroke-dasharray: 5 3; }
.chart .lvl.support { stroke: var(--up); } .chart .lvl.resistance { stroke: var(--down); }
.chart .lvltag { font-size: 10px; } .chart .lvltag.support { fill: var(--up); } .chart .lvltag.resistance { fill: var(--down); }
.chart .sma50 { fill: none; stroke: var(--sma50); stroke-width: 1.4; }
.chart .sma200 { fill: none; stroke: var(--sma200); stroke-width: 1.4; }
.chart .sigbar { fill: var(--sig); }
.chart .pivot { fill: var(--muted); opacity: .55; } .chart .pivot.used { fill: var(--accent); opacity: 1; }
.chart .rsi { fill: none; stroke: var(--rsi); stroke-width: 1.3; }
.chart .rsiline { stroke: var(--muted); stroke-dasharray: 4 3; }
.legend { font-size: 12px; color: var(--muted); }
.legend i { display: inline-block; width: 14px; height: 3px; vertical-align: middle; margin: 0 4px 0 10px; }
ul.check { list-style: none; padding-left: 0; margin: 4px 0; }
ul.check li { margin: 2px 0; }
ul.check label { cursor: pointer; }
.strategy { border-top: 1px solid var(--line); padding-top: 10px; margin-top: 12px; }
.alerts { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12.5px; }
.alerts td { padding: 4px 6px; }
button.copy { font: 11px system-ui; border: 1px solid var(--line); background: var(--chip); color: var(--ink); border-radius: 5px; padding: 1px 7px; cursor: pointer; }
pre.alertblock { background: var(--chip); padding: 8px 10px; border-radius: 6px; white-space: pre-wrap; font-size: 12px; }
details summary { cursor: pointer; color: var(--accent); }
.evidence { font-size: 12px; color: var(--muted); margin: 2px 0 0 0; overflow-wrap: anywhere; }
.evidence code { font-size: 11.5px; }
footer { margin: 34px 0 20px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 10px; }
.themebtn { float: right; }
@media print {
  body { background: #fff; color: #000; }
  .filters, button, .themebtn { display: none !important; }
  .card { break-inside: avoid; border-color: #bbb; }
  details { display: block; } details > * { display: block; }
}
</style>
</head>
<body>
<main>
<button class="copy themebtn" type="button" onclick="toggleTheme()" title="Toggle light/dark">◐ theme</button>
<h1>Technical Opportunity Scan</h1>
<div class="muted">As of {{ res.as_of }} · generated {{ started }}{% if res.focus_symbols %} · deep dive: {{ res.focus_symbols|join(", ") }}{% endif %}</div>

{# ---------------------------------------------------------------- 1. Run summary #}
<section id="summary">
<h2>Run summary</h2>
{% if res.provisional %}
<div class="banner">PROVISIONAL: the latest bar ({{ res.as_of }}) is still forming. Signals on it are marked PENDING_CLOSE — re-run after the close.</div>
{% endif %}
{% for n in res.notes %}<div class="banner">{{ n }}</div>{% endfor %}
<div class="grid">
  <div class="panel stat"><b>{{ res.as_of }}</b><span>as-of session</span></div>
  <div class="panel stat"><b>{{ bars_through or "n/a" }}</b><span>completed bars through</span></div>
  <div class="panel stat"><b>{{ res.analyses|length }} / {{ res.analyses|length + res.skipped|length }}</b><span>symbols scanned</span></div>
  <div class="panel stat"><b>{{ res.candidates|length }}</b><span>candidates (symbol × strategy)</span></div>
  <div class="panel stat"><b>{{ res.watchlist|length }}</b><span>watch items</span></div>
  <div class="panel stat"><b>{{ res.strategies_enabled|length }}</b><span>strategies enabled ({{ res.strategies_skipped|length }} skipped)</span></div>
  <div class="panel stat"><b>{{ settings_hash }}</b><span>settings hash · strategies {{ strategies_hash }}</span></div>
  <div class="panel stat"><b>{{ "%.1f"|format(res.runtime_s) }} s</b><span>runtime</span></div>
</div>
{% if res.skipped %}<p><b>Skipped symbols:</b> {% for sym, why in res.skipped %}<span class="chip">{{ sym }}: {{ why }}</span>{% endfor %}</p>{% endif %}
{% if res.strategies_skipped %}<p><b>Skipped strategies:</b> {% for sid, why in res.strategies_skipped %}<span class="chip">{{ strategy_names.get(sid, sid) }} ({{ why }})</span>{% endfor %}</p>{% endif %}
</section>

{# ---------------------------------------------------------------- 2. Market context #}
<section id="market">
<h2>Market context</h2>
{% if market %}
<div class="panel">
  <b>{{ market.symbol }}</b> {{ market.close|money }} · trend <span class="tag {{ market.trend.state }}">{{ market.trend.state }}</span>
  · 1m {{ market.returns["1m"]|pct }} · 3m {{ market.returns["3m"]|pct }} · 6m {{ market.returns["6m"]|pct }}
  <div class="evidence">{{ market.trend.reason }}</div>
  <div class="cols" style="margin-top:8px">
    <div><h4>Supports below</h4>{% for l in market.supports %}<div>{{ l.type }}{% if l.manual %} (manual){% endif %} <b>{{ l.level|money }}</b> <span class="muted">zone {{ l.zone_low|num }}–{{ l.zone_high|num }} · {{ l.dist_atr|num(1) }} ATR</span></div>{% else %}<div class="muted">none</div>{% endfor %}</div>
    <div><h4>Resistances above</h4>{% for l in market.resistances %}<div>{{ l.type }}{% if l.manual %} (manual){% endif %} <b>{{ l.level|money }}</b> <span class="muted">zone {{ l.zone_low|num }}–{{ l.zone_high|num }} · +{{ l.dist_atr|num(1) }} ATR</span></div>{% else %}<div class="muted">none</div>{% endfor %}</div>
  </div>
</div>
{% else %}
<div class="banner">Benchmark data unavailable — flow alignment components are n/a.</div>
{% endif %}
{% if sectors %}
<div class="tablewrap"><table>
<thead><tr><th>Sector ETF</th><th>Trend</th><th>vs {{ res.benchmark }}</th><th class="num">1m</th><th class="num">3m</th><th class="num">6m</th><th>Universe members</th></tr></thead>
<tbody>
{% for e in sectors %}
<tr><td><b>{{ e.etf }}</b></td><td><span class="tag {{ e.trend }}">{{ e.trend }}</span></td><td><span class="tag {{ e.vs }}">{{ e.vs }}</span></td>
<td class="num">{{ e.returns.get("1m")|pct }}</td><td class="num">{{ e.returns.get("3m")|pct }}</td><td class="num">{{ e.returns.get("6m")|pct }}</td>
<td>{{ (e.members or [])|join(", ") }}</td></tr>
{% endfor %}
</tbody></table></div>
{% endif %}
</section>

{# ---------------------------------------------------------------- 3. Ranked shortlist #}
<section id="shortlist">
<h2>Ranked shortlist</h2>
{% if rows %}
<div class="filters">
  <select data-filter="strategies"><option value="">All strategies</option>{% for v in filters.strategies %}<option value="{{ v }}">{{ strategy_names.get(v, v) }}</option>{% endfor %}</select>
  <select data-filter="biases"><option value="">All biases</option>{% for v in filters.biases %}<option>{{ v }}</option>{% endfor %}</select>
  <select data-filter="signals"><option value="">All signals</option>{% for v in filters.signals %}<option>{{ v }}</option>{% endfor %}</select>
  <select data-filter="flows"><option value="">All alignment</option>{% for v in filters.flows %}<option>{{ v }}</option>{% endfor %}</select>
</div>
<div class="tablewrap"><table id="shortlist-table">
<thead><tr>
<th class="sortable num" data-type="num">Rank</th><th class="sortable">Symbol</th><th class="sortable num" data-type="num">Price</th>
<th>Strategies</th><th class="sortable">Primary signal</th><th class="sortable num" data-type="num">Score</th>
<th class="sortable">Trend</th><th class="sortable">Flow</th><th class="sortable num" data-type="num">RSI</th>
<th>Nearest level</th><th class="sortable num" data-type="num">Age</th><th>Alert level</th>
</tr></thead>
<tbody>
{% for r in rows %}
<tr data-strategies="{{ r.strategies }}" data-biases="{{ r.biases }}" data-signals="{{ r.signals }}" data-flows="{{ r.flows }}">
<td class="num" data-v="{{ r.rank }}">{{ r.rank }}</td>
<td><a href="#card-{{ r.symbol }}"><b>{{ r.symbol }}</b></a>{% if r.pending %} <span class="tag pending">pending</span>{% endif %}</td>
<td class="num" data-v="{{ r.price }}">{{ r.price|money }}</td>
<td class="chips">{% for c in r.cands %}<span class="chip {{ c.bias }}" title="#{{ c.strategy_rank }} in {{ c.strategy_name }} · score {{ c.score }}{% if c.pending %} · PENDING_CLOSE{% endif %}">{{ c.strategy_name }}</span>{% endfor %}</td>
<td>{{ r.best.primary.summary if r.best.primary else "—" }}{% if r.best.stretched %} <span class="tag stretched">stretched</span>{% endif %}</td>
<td class="num" data-v="{{ r.best.score }}"><b>{{ r.best.score|num(1) }}</b></td>
<td><span class="tag {{ r.trend }}">{{ r.trend }}</span></td>
<td><span class="tag {{ r.best.flow_label }}">{{ r.best.flow_label }}</span></td>
<td class="num" data-v="{{ r.rsi }}">{{ r.rsi|num(1) }}</td>
<td>{% if r.nearest %}{{ r.nearest.level.label }} {{ r.nearest.value|money }} <span class="muted">({{ r.nearest.dist_atr|num(1) }} ATR)</span>{% else %}—{% endif %}</td>
<td class="num" data-v="{{ r.best.primary.age if r.best.primary else 0 }}">{{ r.best.primary.age if r.best.primary else "—" }}</td>
<td>{% if r.alert %}<span class="alerts">{{ "%.2f"|format(r.alert.price) }}</span> <button class="copy" type="button" data-copy="{{ "%.2f"|format(r.alert.price) }}" title="{{ r.alert.meaning }}">copy</button>{% endif %}</td>
</tr>
{% endfor %}
</tbody></table></div>
{% else %}
<div class="panel muted">No candidates matched the enabled strategies on this bar.</div>
{% endif %}
</section>

{# ---------------------------------------------------------------- 4. Candidate cards #}
<section id="cards">
<h2>Candidate cards</h2>
{% for card in cards %}
{% set sa = card.sa %}
<article class="card" id="card-{{ card.symbol }}">
<header>
  <h3>{{ card.symbol }}</h3>
  <span><b>{{ card.close|money }}</b> <span class="{{ 'up' if card.change >= 0 else 'down' }}">{{ "%+.2f"|format(card.change) }} ({{ "%+.2f"|format(card.change_pct) }}%)</span></span>
  <span class="muted">as of {{ sa.as_of }}{% if sa.provisional %} (provisional){% endif %}</span>
  {% if card.best %}<span>score <b>{{ card.best.score|num(1) }}</b> · rank #{{ card.best.rank }}</span>{% else %}<span class="muted">no strategy matched</span>{% endif %}
</header>
{{ card.chart|safe }}
<div class="legend"><i style="background:var(--sma50)"></i>SMA50<i style="background:var(--sma200)"></i>SMA200<i style="background:var(--sup);height:9px"></i>support zone<i style="background:var(--res);height:9px"></i>resistance zone<i style="background:var(--accent);height:6px;width:6px"></i>pivots used for trend<i style="background:var(--sig);height:9px"></i>signal bar</div>

<div class="cols">
<div>
<h4>Technical read</h4>
<div>Trend <span class="tag {{ sa.trend.state }}">{{ sa.trend.state }}</span> <span class="evidence">{{ sa.trend.reason }}</span></div>
{% if sa.trend.state == "range" %}
<div class="evidence">Range {{ sa.trend.range_low.value(sa.completed_idx)|money }} – {{ sa.trend.range_high.value(sa.completed_idx)|money }} · width {{ sa.trend.range_width_atr|num(1) }} ATR · position {{ sa.trend.range_position|num(2) }}{% if sa.trend.range_mid %} (mid band){% endif %}</div>
{% endif %}
<div>Pivots used: {% for p in sa.trend.pivots_used %}<span class="chip">{{ p.kind }} {{ p.date }} {{ p.price|num }}</span>{% endfor %}</div>
<div>RSI(14) <b>{{ card.rsi|num(1) }}</b> — {{ card.rsi_verdict }} · relative volume {{ card.relvol|num(2) }}× <span class="muted">(info)</span> · ATR {{ sa.bars.atr[sa.last_idx]|num }}</div>
<div class="muted">Returns: 1m {{ card.returns["1m"]|pct }} · 3m {{ card.returns["3m"]|pct }} · 6m {{ card.returns["6m"]|pct }}</div>
</div>
<div>
<h4>Relative strength</h4>
{% if sa.flow %}
{% for name, st in sa.flow.components() %}<div>{{ name }}: <span class="tag {{ st }}">{{ st }}</span></div>{% endfor %}
{% endif %}
{% for c in card.cands %}<div>{{ c.strategy_name }} ({{ c.bias }}): <span class="tag {{ c.flow_label }}">{{ c.flow_label }}</span></div>{% endfor %}
</div>
</div>

<h4>Levels</h4>
<div class="tablewrap"><table>
<thead><tr><th>Id</th><th>Type</th><th>Role</th><th class="num">Level</th><th class="num">Zone</th><th class="num">Dist</th><th class="num">Touches</th><th>Confluence</th><th>Anchors / last touch</th></tr></thead>
<tbody>
{% for l in card.levels %}
<tr><td>{{ l.id }}</td><td>{{ l.type }}{% if l.manual %} (manual){% endif %}</td>
<td>{{ l.role }}{% if l.role_reversal %} <span class="chip">role reversal</span>{% endif %}</td>
<td class="num">{{ l.level|money }}</td><td class="num">{{ l.zone_low|num }}–{{ l.zone_high|num }}</td>
<td class="num">{{ l.dist_pct|num(1) }}% · {{ l.dist_atr|num(1) }} ATR</td><td class="num">{{ l.touches }}</td>
<td>{{ l.confluence|join(", ") }}</td>
<td class="muted">{% for d, p in l.anchors[-3:] %}{{ d }} @ {{ p|num }}{% if not loop.last %}; {% endif %}{% endfor %}{% if l.type == "diagonal" %} · slope {{ l.slope|num(3) }}/bar{% endif %}{% if l.note %} · {{ l.note }}{% endif %}</td></tr>
{% endfor %}
</tbody></table></div>
{% if card.confluence %}<div class="evidence">Confluence zones: {% for z in card.confluence %}<span class="chip">{{ z.zone_low|num }}–{{ z.zone_high|num }}: {{ z.sources|join(" + ") }}</span>{% endfor %}</div>{% endif %}

<h4>Signals fired</h4>
{% if card.signals %}
<ul class="check">
{% for sg in card.signals %}
<li><span class="tag {{ sg.status.value }}">{{ sg.status.value }}</span> <b>{{ sg.summary }}</b> <span class="muted">{{ sg.date }}</span>
<details><summary>evidence</summary><div class="evidence"><code>{{ sg.evidence|evjson }}</code></div></details></li>
{% endfor %}
</ul>
{% else %}<div class="muted">No signals on the latest {{ s.signals.max_signal_age_bars + 1 }} bar(s).</div>{% endif %}

<h4>Strategies {{ "evaluated" if deep else "matched" }}</h4>
{% for st in card.strategies %}
<div class="strategy">
<div><span class="chip {{ st.bias }}">{{ st.name }}</span> <span class="tag {{ st.match }}">{{ "MATCH" if st.match == "true" else st.match }}</span>
<span class="muted">{{ st.bias }} · status {{ st.status }}{% if st.cand %} · score {{ st.cand.score|num(1) }} · #{{ st.cand.strategy_rank }} in strategy{% endif %}</span>
{% if st.cand and st.cand.stretched %}<span class="tag stretched">stretched (&gt; {{ s.signals.chase_atr }} ATR beyond zone)</span>{% endif %}</div>
{% if st.description %}<div class="muted">{{ st.description }}</div>{% endif %}
<table>
<thead><tr><th>Rule</th><th>Result</th><th>Detail</th></tr></thead>
<tbody>
{% for r in st.rules %}<tr><td>{{ r.rule }}</td><td><span class="tag {{ r.status.value }}">{{ r.status.value }}</span></td><td>{{ r.detail }}{% for e in r.evidence %}<div class="evidence">{{ e }}</div>{% endfor %}</td></tr>{% endfor %}
</tbody></table>
<div class="cols">
<div>
{% if st.orats %}<h4>ORATS checklist (manual)</h4><ul class="check">{% for item in st.orats %}<li><label><input type="checkbox"> {{ item }}</label></li>{% endfor %}</ul>{% endif %}
{% if st.manual %}<h4>Other manual checks</h4><ul class="check">{% for item in st.manual %}<li><label><input type="checkbox"> {{ item }}</label></li>{% endfor %}</ul>{% endif %}
</div>
<div>
{% if st.construction %}<h4>Construction</h4><ul>{% for item in st.construction %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
{% if st.plan %}<h4>Plan</h4><ul>{% for key, val in st.plan %}<li><b>{{ key }}:</b> {% if val is string or val is number %}{{ val }}{% else %}<ul>{% for v in val %}<li>{{ v }}</li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>{% endif %}
{% for key, val in st.extra.items() %}<div><b>{{ key }}:</b> {{ val }}</div>{% endfor %}
</div>
</div>
{% if st.cand %}
<details><summary>Score breakdown ({{ st.cand.score|num(1) }})</summary>
<table><thead><tr><th>Component</th><th class="num">Raw (0–1)</th><th class="num">Weight</th><th class="num">Points</th><th>Note</th></tr></thead>
<tbody>{% for x in st.cand.components %}<tr><td>{{ x.name }}</td><td class="num">{{ x.raw|num(2) }}</td><td class="num">{{ x.weight|num(0) }}</td><td class="num">{{ x.points|num(1) }}</td><td class="muted">{{ x.note }}</td></tr>{% endfor %}</tbody></table>
</details>
{% endif %}
</div>
{% endfor %}

{% if card.alerts %}
<h4>Alert helper (TradingView)</h4>
<table class="alerts"><tbody>
{% for a in card.alerts %}<tr><td>{{ a.label }}</td><td class="num"><b>{{ "%.2f"|format(a.price) }}</b></td><td><button class="copy" type="button" data-copy="{{ "%.2f"|format(a.price) }}">copy</button></td><td class="muted">{{ a.meaning }}</td></tr>{% endfor %}
</tbody></table>
{% set block %}{% for a in card.alerts %}{{ card.symbol }} {{ a.label }}: {{ "%.2f"|format(a.price) }} — {{ a.meaning }}
{% endfor %}{% endset %}
<pre class="alertblock">{{ block }}</pre>
<button class="copy" type="button" data-copy="{{ block }}">copy all</button>
{% endif %}
</article>
{% else %}
<div class="panel muted">No candidate cards.</div>
{% endfor %}
</section>

{# ---------------------------------------------------------------- 5. Watch list #}
<section id="watch">
<h2>Watch list (near-setups)</h2>
{% if watch %}
<div class="tablewrap"><table>
<thead><tr><th>Symbol</th><th>Setup</th><th>Strategies</th><th class="num">Distance</th><th>Trigger prices</th></tr></thead>
<tbody>
{% for w in watch %}
<tr><td><b>{{ w.symbol }}</b></td><td><b>{{ w.near.signal }}</b>{% if w.near.level %} · {{ w.near.level.label }}{% endif %}<div class="evidence">{{ w.near.description }}</div></td>
<td>{% for sid, sname in w.strategies %}<span class="chip">{{ sname }}</span>{% endfor %}</td>
<td class="num">{{ w.near.distance_atr|num(2) }} ATR</td>
<td class="alerts">{% for a in w.near.triggers %}<div>{{ a.label }} <b>{{ "%.2f"|format(a.price) }}</b> <button class="copy" type="button" data-copy="{{ "%.2f"|format(a.price) }}">copy</button> <span class="muted">{{ a.meaning }}</span></div>{% endfor %}</td></tr>
{% endfor %}
</tbody></table></div>
{% else %}<div class="panel muted">No near-setups.</div>{% endif %}
</section>

{# ---------------------------------------------------------------- 6. Diagnostics #}
<section id="diagnostics">
<h2>Skipped &amp; diagnostics</h2>
{% if not (errors or warnings or infos or res.skipped or res.strategies_skipped) %}<div class="panel muted">No issues.</div>{% endif %}
{% if errors %}<h4>Errors</h4><ul>{% for d in errors %}<li><b>{{ d.symbol or "—" }}</b> [{{ d.stage }}] {{ d.message }}</li>{% endfor %}</ul>{% endif %}
{% if res.skipped %}<h4>Skipped symbols</h4><ul>{% for sym, why in res.skipped %}<li><b>{{ sym }}</b>: {{ why }}</li>{% endfor %}</ul>{% endif %}
{% if warnings %}<h4>Data-quality warnings</h4><ul>{% for d in warnings %}<li><b>{{ d.symbol or "—" }}</b> [{{ d.stage }}] {{ d.message }}</li>{% endfor %}</ul>{% endif %}
{% if res.strategies_skipped %}<h4>Disabled / stub strategies</h4><ul>{% for sid, why in res.strategies_skipped %}<li>{{ strategy_names.get(sid, sid) }} — {{ why }}</li>{% endfor %}</ul>{% endif %}
{% if infos %}<details><summary>Info ({{ infos|length }})</summary><ul>{% for d in infos %}<li><b>{{ d.symbol or "—" }}</b> [{{ d.stage }}] {{ d.message }}</li>{% endfor %}</ul></details>{% endif %}
</section>

<footer>{{ disclaimer }}</footer>
</main>
<script>
(function () {
  function toggleTheme() {
    var r = document.documentElement, cur = r.getAttribute("data-theme");
    var dark = cur ? cur === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    r.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("scan-theme", r.getAttribute("data-theme")); } catch (e) {}
  }
  window.toggleTheme = toggleTheme;
  try { var t = localStorage.getItem("scan-theme"); if (t) document.documentElement.setAttribute("data-theme", t); } catch (e) {}

  document.addEventListener("click", function (ev) {
    var b = ev.target.closest("button[data-copy]");
    if (!b) return;
    var text = b.getAttribute("data-copy");
    function done() { var o = b.textContent; b.textContent = "copied"; setTimeout(function () { b.textContent = o; }, 1200); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, function () { fallback(text); done(); });
    } else { fallback(text); done(); }
  });
  function fallback(text) {
    var ta = document.createElement("textarea"); ta.value = text; document.body.appendChild(ta);
    ta.select(); try { document.execCommand("copy"); } catch (e) {} document.body.removeChild(ta);
  }

  var table = document.getElementById("shortlist-table");
  if (!table) return;
  var tbody = table.tBodies[0];
  Array.prototype.forEach.call(table.tHead.rows[0].cells, function (th, idx) {
    if (!th.classList.contains("sortable")) return;
    th.addEventListener("click", function () {
      var asc = th.getAttribute("data-dir") !== "asc";
      th.setAttribute("data-dir", asc ? "asc" : "desc");
      var num = th.getAttribute("data-type") === "num";
      var rows = Array.prototype.slice.call(tbody.rows);
      rows.sort(function (a, b) {
        var x = a.cells[idx], y = b.cells[idx];
        var va = x.getAttribute("data-v") || x.textContent.trim(), vb = y.getAttribute("data-v") || y.textContent.trim();
        if (num) { va = parseFloat(va) || 0; vb = parseFloat(vb) || 0; return asc ? va - vb : vb - va; }
        return asc ? va.localeCompare(vb) : vb.localeCompare(va);
      });
      rows.forEach(function (r) { tbody.appendChild(r); });
    });
  });
  var selects = document.querySelectorAll(".filters select");
  function apply() {
    Array.prototype.forEach.call(tbody.rows, function (r) {
      var show = true;
      selects.forEach(function (s) {
        var v = s.value; if (!v) return;
        var have = (r.getAttribute("data-" + s.getAttribute("data-filter")) || "").split(" ");
        if (have.indexOf(v) < 0) show = false;
      });
      r.style.display = show ? "" : "none";
    });
  }
  selects.forEach(function (s) { s.addEventListener("change", apply); });
})();
</script>
</body>
</html>
