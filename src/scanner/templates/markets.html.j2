<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root { --bg: #fcfcfb; --fg: #0b0b0b; --muted: #52514e; --line: #e2e1dc; --accent: #7579c7; --card: #ffffff; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1280px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { margin: 0 0 4px; font-size: 1.6rem; }
h2 { margin: 36px 0 12px; font-size: 1.2rem; border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
h3 { margin: 20px 0 8px; font-size: 1rem; }
.meta { color: var(--muted); }
table { border-collapse: collapse; width: 100%; margin: 8px 0 16px; font-variant-numeric: tabular-nums; }
th, td { padding: 4px 8px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
th { color: var(--muted); font-weight: 600; }
.scroll { overflow-x: auto; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px; margin: 12px 0; }
ul.diag { color: var(--muted); font-size: 0.9rem; }
nav a { color: var(--accent); margin-right: 16px; }
</style>
</head>
<body>
<main>
<h1>{{ title }}</h1>
<div class="meta">Prices as of {{ as_of }} · generated {{ generated }}</div>
<nav><a href="#structure">Structure</a><a href="#rotation">Rotation</a><a href="#correlation">Correlation</a></nav>

{% macro table(t) %}
<div class="scroll"><table>
<thead><tr>{% for c in t.cols %}<th>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>{% for r in t.rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>{% endfor %}</tbody>
</table></div>
{% endmacro %}

<h2 id="structure">Structure</h2>
{{ table(summary) }}
{% for s in structure %}
<div class="card">
<h3>{{ s.label }}</h3>
{{ s.fig | safe }}
{{ table(s.levels) }}
</div>
{% endfor %}

<h2 id="rotation">Rotation vs {{ benchmark }}</h2>
{% if rrg_fig %}{{ rrg_fig | safe }}{% else %}<p class="meta">No members could be plotted.</p>{% endif %}
{{ table(rrg_table) }}

<h2 id="correlation">Correlation</h2>
{% for f in pca_figs %}<div class="card">{{ f | safe }}</div>{% else %}<p class="meta">Not enough common history for PCA.</p>{% endfor %}
{% if shifts.rows %}<h3>Largest correlation shifts</h3>{{ table(shifts) }}{% endif %}

{% if diagnostics %}
<h2>Data notes</h2>
<ul class="diag">{% for d in diagnostics %}<li>{{ d }}</li>{% endfor %}</ul>
{% endif %}
</main>
</body>
</html>
